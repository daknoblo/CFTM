# Required. A dedicated read-only token, see docs/cloudflare-token.md.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# End-to-end probing. Leave false to monitor via the API only.
CFTM_PROBE_ENABLED=false

# Access service token, only read when CFTM_PROBE_ENABLED=true.
# In a Terraform-managed account, fill both in one go:
#   cd infra && terraform output -json monitor_service_token \
#     | jq -r '"CFTM_ACCESS_CLIENT_ID=" + .client_id,
#              "CFTM_ACCESS_CLIENT_SECRET=" + .client_secret'
CFTM_ACCESS_CLIENT_ID=
CFTM_ACCESS_CLIENT_SECRET=
