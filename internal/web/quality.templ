package web

import (
	"fmt"
	"net/url"
)

templ TunnelQualityCard(q TunnelQuality) {
	<section id="tunnel-quality" class="card mb-6" hx-get={ q.RefreshURL } hx-trigger="every 10s" hx-swap="outerHTML" aria-label="HTTP response time and stability">
		<h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-400">Response time &amp; stability · last 24 hours</h2>
		<p data-quality-error role="alert" class="alert-error mb-4" hidden>Chart refresh failed. Displayed measurements may be outdated; reload the page to retry.</p>
		<p class="mb-4 text-xs text-slate-400">
			HTTP time to response headers from CFTM through Cloudflare, including application processing.
			Not ICMP ping, network jitter or packet loss. Access and known cached responses are excluded.
		</p>
		if !q.Enabled {
			<p class="alert-warn mb-4">Probing is disabled. Set CFTM_PROBE_ENABLED=true to collect new samples. Any stored history is shown below.</p>
		}
		if len(q.Hostnames) == 0 {
			<p class="text-sm text-slate-400">No probeable HTTP/HTTPS hostname on this tunnel.</p>
		} else {
			<form id="quality-host-form" hx-preserve method="get" action={ templ.SafeURL("/tunnels/" + url.PathEscape(q.TunnelID)) } class="mb-4 flex flex-wrap items-center gap-3">
				<label for="quality-hostname" class="text-sm text-slate-300">Hostname</label>
				<select id="quality-hostname" name="hostname" class="select-filter max-w-full">
					for _, host := range q.Hostnames {
						<option value={ host } selected?={ host == q.Hostname }>{ host }</option>
					}
				</select>
				<button type="submit" class="btn-ghost">Show</button>
				<span class="text-xs text-slate-500">Probe interval: { q.Interval }</span>
			</form>
			if q.Samples == 0 {
				<p class="text-sm text-slate-400">No samples in the last 24 hours. Missing measurements are not zero latency or downtime.</p>
			} else {
				<div class="mb-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
					@qualityMetric("Median response", q.MedianMS, "ms")
					@qualityMetric("P95 response", q.P95MS, "ms")
					@qualityMetric("Mean variation", q.VariationMS, "ms")
					@qualityMetric("Failed checks", q.FailurePercent, "%")
				</div>
				<div class="overflow-x-auto">
					<svg viewBox="0 0 1000 255" class="w-full min-w-[600px]" role="img" aria-label={ "24-hour HTTP response time and variation for " + q.Hostname }>
						<title>{ q.Hostname }: HTTP response time and variation</title>
						<desc>Five-minute means with minimum and maximum response times. Red markers show failed checks; amber markers show excluded checks. Blank areas have no eligible measurements.</desc>
						<path d="M50,20 H950 M50,105 H950 M50,190 H950" class="stroke-slate-700" fill="none"></path>
						<text x="45" y="24" text-anchor="end" class="fill-slate-400 text-xs">{ fmt.Sprintf("%.0f", q.Chart.MaxMS) }</text>
						<text x="45" y="109" text-anchor="end" class="fill-slate-400 text-xs">{ fmt.Sprintf("%.0f", q.Chart.MaxMS/2) }</text>
						<text x="45" y="194" text-anchor="end" class="fill-slate-400 text-xs">0 ms</text>
						<path d={ q.Chart.LatencyPath } class="stroke-sky-400" stroke-width="2" fill="none"></path>
						<path d={ q.Chart.VariationPath } class="stroke-violet-400" stroke-width="2" stroke-dasharray="4 3" fill="none"></path>
						for _, p := range q.Chart.Points {
							<g>
								<title>{ p.Label }</title>
								if p.HasLatency {
									<line x1={ p.X } x2={ p.X } y1={ p.LowY } y2={ p.HighY } class="stroke-sky-400" stroke-opacity="0.5"></line>
									<circle cx={ p.X } cy={ p.Y } r="2" class="fill-sky-400"></circle>
								}
								if p.HasVariation {
									<circle cx={ p.X } cy={ p.VariationY } r="2" class="fill-violet-400"></circle>
								}
								if p.Failures > 0 {
									<circle cx={ p.X } cy="210" r="3" class="fill-rose-400"></circle>
								}
								if p.Excluded > 0 {
									<circle cx={ p.X } cy="222" r="3" class="fill-amber-400"></circle>
								}
							</g>
						}
						<text x="50" y="247" class="fill-slate-400 text-xs">24h ago</text>
						<text x="275" y="247" text-anchor="middle" class="fill-slate-400 text-xs">18h</text>
						<text x="500" y="247" text-anchor="middle" class="fill-slate-400 text-xs">12h</text>
						<text x="725" y="247" text-anchor="middle" class="fill-slate-400 text-xs">6h</text>
						<text x="950" y="247" text-anchor="end" class="fill-slate-400 text-xs">Now</text>
					</svg>
				</div>
				<div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
					<span class="text-sky-400">Response mean / min–max</span>
					<span class="text-violet-400">Response variation (dashed)</span>
					<span class="text-rose-400">{ fmt.Sprintf("%d failed", q.Failures) }</span>
					<span class="text-amber-400">{ fmt.Sprintf("%d excluded / unverified", q.Excluded) }</span>
					<span class="text-slate-400">{ fmt.Sprintf("%d eligible / %d total checks", q.Successful, q.Samples) }</span>
				</div>
				<p class="mt-3 text-xs text-slate-500">
					Five-minute buckets; whiskers preserve spikes. Statistics use individual eligible samples.
					Variation is the mean absolute difference between consecutive eligible checks, never across failures or gaps longer than 1.5 probe intervals.
					Failed-check percentage excludes Access/cache checks and missing measurements.
				</p>
				<p class="mt-2 text-xs text-slate-500">
					Last sample: @timestamp(FormatTime(q.LastSample), "never")
					if q.Stale {
						<span class="badge badge-warn ml-2">Stale measurements</span>
					}
				</p>
			}
		}
		<p class="mt-3 text-xs text-slate-500">
			Measurements belong to the selected hostname, not a specific connector or physical link.
			Older samples may include cache hits collected before cache detection was available.
		</p>
	</section>
}

templ qualityMetric(label string, value *float64, unit string) {
	<div>
		<div class="text-xs uppercase tracking-wide text-slate-500">{ label }</div>
		<div class="text-xl font-semibold text-slate-100">
			if value == nil {
				<span title="Not enough eligible measurements">—</span>
			} else {
				{ fmt.Sprintf("%.1f %s", *value, unit) }
			}
		</div>
	</div>
}
